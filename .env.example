APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=menu
POSTGRES_USER=menu
POSTGRES_PASSWORD=menu
DATABASE_URL=postgresql+asyncpg://menu:menu@postgres:5432/menu
DATA_ROOT=/data
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=30
MAX_SITE_IMAGE_BYTES=8388608
WORKER_POLL_SECONDS=2
OCR_LANGUAGES=rus+eng
OCR_DPI=220
OCR_MAX_PIXELS=30000000
OCR_TIMEOUT_SECONDS=120
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=
MAX_API_BASE_URL=https://platform-api2.max.ru
# Chat of the support team (the bot must be a member); empty — tickets are only stored.
SUPPORT_CHAT_ID=
MAX_BOT_REQUIRE_DIALOG=true
BOT_CHECKS_INTERVAL_SECONDS=900
PUBLIC_APP_URL=http://localhost:8080
MAX_INIT_DATA_MAX_AGE_SECONDS=900
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=menu_session
DEV_AUTH_ENABLED=true
DEV_MAX_USER_ID=900000001
AI_PROPOSAL_TTL_SECONDS=600
# AI features: OpenAI-compatible gateway (RouterAI). auto = on when AI_API_KEY is
# set, otherwise «ИИ недоступен»; mock = labelled offline demo/CI adapter (answers marked
# «Демо-ИИ»); off = always unavailable. The key lives only in .env, never in Git.
AI_PROVIDER=auto
AI_BASE_URL=https://routerai.ru/api/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-omni-flash
AI_REQUEST_TIMEOUT_SECONDS=20
AI_CACHE_TTL_SECONDS=600
AI_GUEST_DAILY_LIMIT=20
AI_ADMIN_DAILY_LIMIT=100
AI_VENUE_DAILY_LIMIT=500
# Anonymous guests: per-address ceiling (any user agent) and % of the venue budget for guests.
AI_GUEST_IP_DAILY_LIMIT=100
AI_GUEST_VENUE_SHARE_PERCENT=70
AI_IMPORT_STRUCTURING=true
MCP_ENABLED=false
MCP_RESOURCE_URL=http://127.0.0.1:8010/mcp
MCP_ISSUER_URL=http://127.0.0.1:8010
MCP_CONFIRMATION_TTL_SECONDS=600
